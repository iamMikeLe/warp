#!/usr/bin/env bash
#
# Builds a release WarpOss.app for this Mac (OSS channel: Git Graph, Worktrees and the other fork
# features) and wraps it in a drag-to-Applications DMG. Without --sign the app is signed ad hoc,
# which only this Mac trusts; with --sign and --notarize it opens normally on any Mac.
#
# Usage: script/macos/personal_dmg [--name AppName] [--icon icon.png]
#                                  [--sign "Developer ID Application: ..."] [--notarize profile]
#                                  [output.dmg]
#   --name      the app's name in Finder, the Dock and the menu bar (default: WarpOss). Only the
#               displayed name changes: settings stay in ~/.warp-oss.
#   --icon      a square PNG (ideally 1024x1024) to use as the app icon
#   --sign      a Developer ID Application identity from `security find-identity -v -p codesigning`
#   --notarize  a notarytool keychain profile (`xcrun notarytool store-credentials`); needs --sign
#   output.dmg  default: ~/Desktop/<AppName>.dmg
#
# One-time setup beyond the normal build tools: cargo install --locked cargo-about@0.8.4

set -euo pipefail

if ! command -v cargo-about > /dev/null; then
  echo "Missing cargo-about (used for the bundled license file):" >&2
  echo "  cargo install --locked cargo-about@0.8.4" >&2
  exit 1
fi

APP_NAME="WarpOss"
ICON_PNG=""
DMG_PATH=""
SIGN_IDENTITY=""
NOTARY_PROFILE=""
while (( $# )); do
  case "$1" in
    --name)
      APP_NAME="${2:?--name needs a value}"
      shift 2
      ;;
    --icon)
      ICON_PNG="${2:?--icon needs a PNG file}"
      shift 2
      ;;
    --sign)
      SIGN_IDENTITY="${2:?--sign needs a signing identity}"
      shift 2
      ;;
    --notarize)
      NOTARY_PROFILE="${2:?--notarize needs a notarytool keychain profile}"
      shift 2
      ;;
    *)
      DMG_PATH="$1"
      shift
      ;;
  esac
done
if [[ ! "$APP_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]]; then
  echo "Use letters, digits, spaces, dots, dashes or underscores in --name." >&2
  exit 1
fi
DMG_PATH="${DMG_PATH:-$HOME/Desktop/$APP_NAME.dmg}"
if [[ -n "$NOTARY_PROFILE" && -z "$SIGN_IDENTITY" ]]; then
  echo "--notarize needs --sign: Apple only notarizes apps signed with a Developer ID." >&2
  exit 1
fi
if [[ -n "$ICON_PNG" ]]; then
  if [[ ! -f "$ICON_PNG" ]]; then
    echo "No such icon file: $ICON_PNG" >&2
    exit 1
  fi
  ICON_PNG="$(cd "$(dirname "$ICON_PNG")" && pwd)/$(basename "$ICON_PNG")"
fi

cd "$(dirname "$0")/../.."

case "$(uname -m)" in
  arm64) TARGET="aarch64-apple-darwin" ;;
  x86_64) TARGET="x86_64-apple-darwin" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
APP="target/$TARGET/release-lto/bundle/osx/WarpOss.app"

STAMP="$(mktemp)"
STAGE=""
trap 'rm -f "$STAMP"; [[ -n "$STAGE" ]] && rm -rf "$STAGE"' EXIT

# Warp's bundle script ends by copying a DMG that only its own (Warp-certificate) signing path
# creates, so it exits with an error after a successful self-signed build. Judge success by
# whether the app was rebuilt instead.
# The per-target variable is joined with the `target.'cfg(...)'` rustflags in .cargo/config.toml,
# whereas RUSTFLAGS would replace them. The remap keeps the home directory (and so the username)
# out of the source paths embedded in the binary.
TARGET_RUSTFLAGS_VAR="CARGO_TARGET_$(tr '[:lower:]-' '[:upper:]_' <<< "$TARGET")_RUSTFLAGS"
export "$TARGET_RUSTFLAGS_VAR=--remap-path-prefix=$HOME=~"
WARP_SKIP_COMMON_SKILLS_INSTALL=1 ./script/bundle --channel oss --selfsign --nouniversal || true

if [[ ! "$APP/Contents/MacOS/warp-oss" -nt "$STAMP" ]]; then
  echo "The build failed: $APP wasn't rebuilt. See the output above." >&2
  exit 1
fi

STAGE="$(mktemp -d)"
STAGED_APP="$STAGE/$APP_NAME.app"
cp -R "$APP" "$STAGED_APP"
PLIST="$STAGED_APP/Contents/Info.plist"
if [[ "$APP_NAME" != "WarpOss" ]]; then
  plutil -replace CFBundleName -string "$APP_NAME" "$PLIST"
  plutil -replace CFBundleDisplayName -string "$APP_NAME" "$PLIST"
fi
if [[ -n "$ICON_PNG" ]]; then
  ICONSET="$STAGE/AppIcon.iconset"
  mkdir "$ICONSET"
  for px in 16 32 128 256 512; do
    sips -z "$px" "$px" "$ICON_PNG" --out "$ICONSET/icon_${px}x${px}.png" > /dev/null
    sips -z $((px * 2)) $((px * 2)) "$ICON_PNG" --out "$ICONSET/icon_${px}x${px}@2x.png" > /dev/null
  done
  ICON_FILE="$(plutil -extract CFBundleIconFile raw "$PLIST")"
  iconutil -c icns "$ICONSET" -o "$STAGED_APP/Contents/Resources/${ICON_FILE%.icns}.icns"
  rm -r "$ICONSET"
fi
if [[ -n "$SIGN_IDENTITY" ]]; then
  # Warp's app group is tied to Warp's own team ID, which another team's certificate can't claim.
  # The app falls back to its regular data directory when the group container is unavailable.
  ENTITLEMENTS="$STAGE/Entitlements.plist"
  cp script/Entitlements.plist "$ENTITLEMENTS"
  plutil -remove 'com\.apple\.security\.application-groups' "$ENTITLEMENTS"
  codesign --force --deep --options runtime --timestamp --sign "$SIGN_IDENTITY" \
    --entitlements "$ENTITLEMENTS" "$STAGED_APP"
  rm "$ENTITLEMENTS"
  codesign --verify --deep --strict "$STAGED_APP"
elif [[ "$APP_NAME" != "WarpOss" || -n "$ICON_PNG" ]]; then
  # Changing the bundle invalidates its signature; sign again the way script/bundle --selfsign
  # does when there's no Apple Development certificate.
  codesign --force --deep --options runtime --sign - \
    --entitlements script/Debug-Entitlements.plist "$STAGED_APP"
fi
ln -s /Applications "$STAGE/Applications"
hdiutil create -volname "$APP_NAME" -srcfolder "$STAGE" -ov -format UDZO "$DMG_PATH"

if [[ -n "$SIGN_IDENTITY" ]]; then
  codesign --force --timestamp --sign "$SIGN_IDENTITY" "$DMG_PATH"
fi
if [[ -n "$NOTARY_PROFILE" ]]; then
  echo "Submitting $DMG_PATH for notarization (usually a few minutes)..."
  NOTARY_OUTPUT="$(xcrun notarytool submit "$DMG_PATH" --keychain-profile "$NOTARY_PROFILE" --wait)"
  echo "$NOTARY_OUTPUT"
  if ! grep -q "status: Accepted" <<< "$NOTARY_OUTPUT"; then
    echo "Notarization failed. See why with:" >&2
    echo "  xcrun notarytool log <submission id> --keychain-profile $NOTARY_PROFILE" >&2
    exit 1
  fi
  xcrun stapler staple "$DMG_PATH"
  spctl --assess --type open --context context:primary-signature --verbose "$DMG_PATH"
fi

echo
echo "Created $DMG_PATH"
echo "Open it and drag $APP_NAME into Applications (quit the running app first)."
